# ============================================
# Docker Compose Environment Variables
# Copy this to .env and set secure values!
# ============================================

# PostgreSQL
POSTGRES_USER=works_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
POSTGRES_DB=works_db

# Redis
REDIS_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# JWT Secrets (use 64+ character random strings)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_STRING

# Cookie Secret
COOKIE_SECRET=CHANGE_THIS_TO_SECURE_STRING

# CORS Origin (your frontend URL)
CORS_ORIGIN=https://your-domain.com
