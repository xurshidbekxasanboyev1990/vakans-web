# Server
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://works_user:works_secure_password_2024@localhost:5432/works_db

# Redis
REDIS_URL=redis://:works_redis_password_2024@localhost:6379

# JWT
JWT_SECRET=works_jwt_secret_key_2024_very_secure_change_in_production
JWT_REFRESH_SECRET=works_jwt_refresh_secret_key_2024_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# SMS (optional)
SMS_PROVIDER=eskiz
SMS_API_KEY=your_sms_api_key
SMS_FROM=Works.uz
