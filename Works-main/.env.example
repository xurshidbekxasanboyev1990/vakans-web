# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# JWT Configuration
JWT_SECRET=your-very-long-and-secure-secret-key-here-min-32-characters
JWT_REFRESH_SECRET=your-refresh-token-secret-key-here-min-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Backend Configuration
API_URL=https://your-project.supabase.co/functions/v1/make-server-5b47a45d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# Environment
NODE_ENV=development
