# ============================================
# PRODUCTION ENVIRONMENT SOZLAMALARI
# ============================================
# Bu fayl serverga ko'chirilganda .env ga o'zgartiriladi

# Server Port (5000 - bizning loyiha porti)
PORT=5000
NODE_ENV=production

# ============================================
# DATABASE SOZLAMALARI
# ============================================
# DIQQAT: 5432 port band! Yangi port ishlatish yoki boshqa DB
DB_HOST=localhost
DB_PORT=15432
# Yoki boshqa database instance
DB_NAME=vakans_production
DB_USER=vakans_prod_user
DB_PASSWORD=KUCHLI_PAROL_SHART

# ============================================
# REDIS SOZLAMALARI  
# ============================================
# Redis container: 16379 (host) → 6379 (container)
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT SOZLAMALARI
# ============================================
# MUHIM: Bu secretlarni o'zgartirish SHART!
JWT_SECRET=o3zgartirilgan-juda-kuchli-va-uzun-secret-key-kamida-64-belgi
JWT_REFRESH_SECRET=boshqa-juda-kuchli-refresh-token-secret-key-64-belgi
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================
# CORS SOZLAMALARI
# ============================================
# Production domain
CORS_ORIGIN=https://vakans.uz,https://www.vakans.uz

# Cookie domain (.vakans.uz - subdomain uchun)
COOKIE_DOMAIN=.vakans.uz

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# ============================================
# SMS SOZLAMALARI (Playmobile.uz)
# ============================================
SMS_API_URL=https://notify.eskiz.uz/api
SMS_EMAIL=sizning-email@example.uz
SMS_PASSWORD=sizning-parolingiz
SMS_SENDER=4546

# ============================================
# SUPABASE (agar kerak bo'lsa)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE=/var/log/vakans/backend.log
