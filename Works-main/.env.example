# Backend API URL
# Development'da /api ishlatiladi (proxy orqali)
# Production'da to'liq URL kiriting
VITE_API_URL=/api

# Demo Mode - faqat development uchun!
# Production'da false bo'lishi SHART
VITE_DEMO_MODE=false

# Local Token Storage - development uchun
# Cookie muammolari bo'lsa true qiling
VITE_USE_LOCAL_TOKENS=false

# JWT Configuration (backend uchun)
JWT_SECRET=your-very-long-and-secure-secret-key-here-min-32-characters
JWT_REFRESH_SECRET=your-refresh-token-secret-key-here-min-32-characters
JWT_ACCESS_EXPIRY=15d
JWT_REFRESH_EXPIRY=30d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# Environment
NODE_ENV=development
