# ================================================
# VAKANS.UZ - Docker Production Environment
# ================================================
# Bu faylni serverga .env sifatida nusxalang
# ================================================

# ================================================
# DATABASE - PostgreSQL
# ================================================
POSTGRES_USER=vakans_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD_MIN_32_CHARS
POSTGRES_DB=vakans_db

# ================================================
# REDIS
# ================================================
REDIS_PASSWORD=CHANGE_THIS_TO_SECURE_REDIS_PASSWORD

# ================================================
# JWT SECRETS (64 belgidan kam bo'lmasin!)
# Yaratish: openssl rand -base64 48
# ================================================
JWT_SECRET=CHANGE_THIS_GENERATE_NEW_64_CHAR_SECRET_USE_OPENSSL
JWT_REFRESH_SECRET=CHANGE_THIS_GENERATE_NEW_64_CHAR_REFRESH_SECRET

# ================================================
# COOKIE SECRET
# ================================================
COOKIE_SECRET=CHANGE_THIS_GENERATE_NEW_COOKIE_SECRET

# ================================================
# CORS - Ruxsat berilgan domenlar
# ================================================
CORS_ORIGIN=https://vakans.uz,https://www.vakans.uz

# ================================================
# SMS - ESKIZ.UZ
# https://notify.eskiz.uz/ dan ro'yxatdan o'ting
# ================================================
ESKIZ_EMAIL=your_eskiz_email@example.com
ESKIZ_PASSWORD=your_eskiz_password
ESKIZ_FROM=4546
SMS_TEST_MODE=false

# ================================================
# NODE ENVIRONMENT
# ================================================
NODE_ENV=production
